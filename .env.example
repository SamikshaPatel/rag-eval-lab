# Copy this file to `.env` and fill in your LangSmith key.
# Load it in your shell with:  set -a && source .env && set +a
# (or install python-dotenv and call load_dotenv() at the top of a script)

# --- LangSmith (free Developer tier: 1 seat, 5,000 traces/month) ---
# Get a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__your_key_here
LANGSMITH_PROJECT=rag-eval-lab

# Legacy variable names (older LangChain builds read these instead — harmless
# to set both):
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_key_here

# --- Google Gemini (LLM judge for eval_custom.py and eval_ragas.py) ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# --- Ollama (local, no key needed) ---
# Only set this if Ollama runs somewhere other than the default.
# OLLAMA_HOST=http://localhost:11434
